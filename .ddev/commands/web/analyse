#!/bin/bash

## Description: Run PHPStan and the code-style check over Appleseed
## Usage: analyse
## Example: "ddev analyse"

cd /var/www/html || exit 1

status=0

if [ -f vendor/bin/phpstan ]; then
  vendor/bin/phpstan analyse --memory-limit=1G || status=1
else
  echo "phpstan is not installed; run 'ddev composer install'."
  status=1
fi

if [ -f vendor/bin/pint ]; then
  vendor/bin/pint --test || status=1
fi

exit $status
