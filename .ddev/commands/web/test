#!/bin/bash

## Description: Run Appleseed's Pest suite
## Usage: test [flags] [args]
## Example: "ddev test", "ddev test --testsuite=Unit", "ddev test --filter=LinkChecker"

if [ ! -f /var/www/html/vendor/bin/pest ]; then
  echo "Dependencies are not installed yet. Run 'ddev composer install' first."
  exit 1
fi

cd /var/www/html || exit 1
exec vendor/bin/pest "$@"
