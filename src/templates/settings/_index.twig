{% extends "_layouts/cp" %}

{% set title = 'Appleseed Settings' %}
{% set selectedSubnavItem = 'settings' %}

{% block content %}

{% if readOnly %}
    <div class="readable">
        <blockquote class="note warning">
            {% if notAdmin ?? false %}
                <p>{{ 'Only an admin can change these settings.'|t('appleseed') }}</p>
            {% else %}
                <p>Administrative changes are disabled on this environment, so these settings are read-only. Set them in your <code>config/appleseed.php</code> file, or enable <code>allowAdminChanges</code> to edit them here.</p>
            {% endif %}
        </blockquote>
    </div>

    {% include 'appleseed/settings/_fields' with { settings: settings, readOnly: true } %}
{% else %}
    <form method="post" accept-charset="UTF-8">
        {{ csrfInput() }}
        {{ actionInput('appleseed/settings/save') }}
        {{ redirectInput('appleseed/settings') }}

        {% include 'appleseed/settings/_fields' with { settings: settings, readOnly: false } %}

        <div class="btngroup">
            <input type="submit" class="btn submit" value="Save">
        </div>
    </form>
{% endif %}

{% endblock %}
