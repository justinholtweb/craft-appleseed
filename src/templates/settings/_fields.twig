{% import "_includes/forms" as forms %}

{# Rendered read-only when administrative changes are disabled for the environment. #}
{% set readOnly = readOnly ?? false %}

<h2>Link Checking</h2>

{{ forms.lightswitchField({
    label: 'Check External Links',
    instructions: 'Whether to check links pointing to external domains.',
    id: 'checkExternalLinks',
    name: 'checkExternalLinks',
    on: settings.checkExternalLinks,
    disabled: readOnly,
}) }}

{{ forms.textField({
    label: 'Timeout (seconds)',
    instructions: 'Maximum time to wait for a response from each URL.',
    id: 'timeout',
    name: 'timeout',
    value: settings.timeout,
    type: 'number',
    min: 1,
    max: 60,
    size: 5,
    errors: settings.getErrors('timeout'),
    disabled: readOnly,
}) }}

{{ forms.textField({
    label: 'Max Retries',
    instructions: 'Number of retry attempts for failed requests (uses exponential backoff).',
    id: 'maxRetries',
    name: 'maxRetries',
    value: settings.maxRetries,
    type: 'number',
    min: 1,
    max: 10,
    size: 5,
    errors: settings.getErrors('maxRetries'),
    disabled: readOnly,
}) }}

{{ forms.textField({
    label: 'Rate Limit (requests/second)',
    instructions: 'Maximum requests per second to the same domain.',
    id: 'rateLimitPerSecond',
    name: 'rateLimitPerSecond',
    value: settings.rateLimitPerSecond,
    type: 'number',
    step: '0.1',
    min: '0.1',
    max: '100',
    size: 5,
    errors: settings.getErrors('rateLimitPerSecond'),
    disabled: readOnly,
}) }}

{{ forms.textField({
    label: 'Scan Batch Size',
    instructions: 'How many links each queue job checks before handing off to the next batch. Smaller batches keep individual jobs short and avoid queue timeouts on large sites; larger batches reduce overhead. This is a maximum — Craft may stop a batch early based on memory usage.',
    id: 'scanBatchSize',
    name: 'scanBatchSize',
    value: settings.scanBatchSize,
    type: 'number',
    min: 1,
    max: 1000,
    size: 5,
    errors: settings.getErrors('scanBatchSize'),
    disabled: readOnly,
}) }}

{{ forms.autosuggestField({
    label: 'User Agent',
    instructions: 'The User-Agent string sent with HTTP requests.',
    id: 'userAgent',
    name: 'userAgent',
    value: settings.userAgent,
    suggestEnvVars: true,
    errors: settings.getErrors('userAgent'),
    disabled: readOnly,
}) }}

<hr>
<h2>Spider</h2>

{{ forms.lightswitchField({
    label: 'Enable Spider',
    instructions: 'Crawl rendered pages via HTTP in addition to scanning the database.',
    id: 'spiderEnabled',
    name: 'spiderEnabled',
    on: settings.spiderEnabled,
    disabled: readOnly,
}) }}

{{ forms.textField({
    label: 'Max Pages to Spider',
    instructions: 'Maximum number of pages the spider will visit per scan.',
    id: 'maxPagesToSpider',
    name: 'maxPagesToSpider',
    value: settings.maxPagesToSpider,
    type: 'number',
    min: 1,
    max: 10000,
    size: 5,
    errors: settings.getErrors('maxPagesToSpider'),
    disabled: readOnly,
}) }}

<hr>
<h2>Scheduling</h2>

{{ forms.selectField({
    label: 'Scan Frequency',
    instructions: 'How often to automatically run a full scan. Scheduled scans start counting from your first completed scan — run one from the dashboard to get the schedule going.',
    id: 'scanFrequency',
    name: 'scanFrequency',
    value: settings.scanFrequency,
    options: [
        { label: 'Manual only', value: 'manual' },
        { label: 'Daily', value: 'daily' },
        { label: 'Weekly', value: 'weekly' },
        { label: 'Monthly', value: 'monthly' },
    ],
    disabled: readOnly,
}) }}

{{ forms.selectField({
    label: 'Scheduled Scan Type'|t('appleseed'),
    instructions: 'What a scheduled scan reads. “Changed entries” only reads entries updated since the last scan, which is much faster on a large site; run a full scan now and then to catch links that broke on their own.'|t('appleseed'),
    id: 'scheduledScanType',
    name: 'scheduledScanType',
    value: settings.scheduledScanType,
    options: [
        { label: 'Full scan'|t('appleseed'), value: 'full' },
        { label: 'Changed entries'|t('appleseed'), value: 'incremental' },
    ],
    errors: settings.getErrors('scheduledScanType'),
    disabled: readOnly,
}) }}

{{ forms.lightswitchField({
    label: 'Scan on Entry Save',
    instructions: 'Automatically scan an entry for broken links whenever it is saved.',
    id: 'scanOnEntrySave',
    name: 'scanOnEntrySave',
    on: settings.scanOnEntrySave,
    disabled: readOnly,
}) }}

<hr>
<h2>Notifications</h2>

{{ forms.autosuggestField({
    label: 'Notification Emails',
    instructions: 'Comma-separated email addresses to notify when broken links are found. Supports environment variables.',
    id: 'notificationEmails',
    name: 'notificationEmails',
    value: settings.notificationEmails,
    suggestEnvVars: true,
    errors: settings.getErrors('notificationEmails'),
    disabled: readOnly,
}) }}

{{ forms.textField({
    label: 'Notification Threshold',
    instructions: 'Minimum number of broken links before sending a notification.',
    id: 'notificationThreshold',
    name: 'notificationThreshold',
    value: settings.notificationThreshold,
    type: 'number',
    min: 1,
    size: 5,
    errors: settings.getErrors('notificationThreshold'),
    disabled: readOnly,
}) }}

{{ forms.lightswitchField({
    label: 'Only Newly Broken Links'|t('appleseed'),
    instructions: 'Notify only when links broke since the scan before — not every time a scan finds links that were already broken. The threshold then counts newly broken links.'|t('appleseed'),
    id: 'notifyOnlyNew',
    name: 'notifyOnlyNew',
    on: settings.notifyOnlyNew,
    disabled: readOnly,
}) }}

{{ forms.autosuggestField({
    label: 'Slack Webhook URL'|t('appleseed'),
    instructions: 'A Slack incoming-webhook URL to post results to, on the same terms as the email. Keep the URL itself in `.env` and enter the environment variable here.'|t('appleseed'),
    id: 'slackWebhookUrl',
    name: 'slackWebhookUrl',
    value: settings.slackWebhookUrl,
    placeholder: '$APPLESEED_SLACK_WEBHOOK',
    suggestEnvVars: true,
    errors: settings.getErrors('slackWebhookUrl'),
    disabled: readOnly,
}) }}

{{ forms.autosuggestField({
    label: 'Scan Webhook URL'|t('appleseed'),
    instructions: 'Appleseed POSTs a JSON summary here after every completed scan (except scans of a single saved entry): the scan, the totals, and up to 100 broken links. For dashboards, chat tools or CI.'|t('appleseed'),
    id: 'webhookUrl',
    name: 'webhookUrl',
    value: settings.webhookUrl,
    placeholder: '$APPLESEED_WEBHOOK_URL',
    suggestEnvVars: true,
    errors: settings.getErrors('webhookUrl'),
    disabled: readOnly,
}) }}

{{ forms.autosuggestField({
    label: 'Webhook Secret'|t('appleseed'),
    instructions: 'Optional. Signs each webhook body as `X-Appleseed-Signature: sha256=<HMAC>`. Use an environment variable.'|t('appleseed'),
    id: 'webhookSecret',
    name: 'webhookSecret',
    value: settings.webhookSecret,
    placeholder: '$APPLESEED_WEBHOOK_SECRET',
    suggestEnvVars: true,
    errors: settings.getErrors('webhookSecret'),
    disabled: readOnly,
}) }}

{{ forms.autosuggestField({
    label: 'Email Layout Template',
    instructions: 'Optional path to a custom Twig template that wraps the scan report email. The template receives a `content` variable with the report HTML — output it with `{{ content|raw }}`. Leave blank to use the default layout.',
    id: 'emailLayoutTemplate',
    name: 'emailLayoutTemplate',
    value: settings.emailLayoutTemplate,
    suggestEnvVars: true,
    suggestTemplates: true,
    errors: settings.getErrors('emailLayoutTemplate'),
    disabled: readOnly,
}) }}

<hr>
<h2>{{ 'Content'|t('appleseed') }}</h2>

{{ forms.textareaField({
    label: 'Excluded Fields'|t('appleseed'),
    instructions: 'Field handles whose links are never collected — fields nobody is going to fix, or that hold links you don’t want checked. One per line, or comma-separated. Applies inside Matrix fields too.'|t('appleseed'),
    id: 'excludedFields',
    name: 'excludedFields',
    value: settings.excludedFields,
    rows: 3,
    class: 'code',
    errors: settings.getErrors('excludedFields'),
    disabled: readOnly,
}) }}

<hr>
<h2>Ignore Patterns</h2>

{{ forms.textareaField({
    label: 'Ignore Patterns',
    instructions: 'One regex pattern per line. URLs matching any pattern are never requested: they\'re skipped during checking and the spider won\'t crawl them. Example: `/^https:\/\/example\.com/`',
    id: 'ignorePatterns',
    name: 'ignorePatterns',
    value: settings.ignorePatterns,
    rows: 6,
    class: 'code',
    errors: settings.getErrors('ignorePatterns'),
    disabled: readOnly,
}) }}

<hr>
<h2>Dashboard</h2>

{{ forms.selectField({
    label: 'Default Status Filter',
    instructions: 'Which status the results table is filtered by when you first open the dashboard. You can still switch to any other status from the filter dropdown.',
    id: 'defaultStatusFilter',
    name: 'defaultStatusFilter',
    value: settings.defaultStatusFilter,
    options: settings.statusFilterOptions,
    errors: settings.getErrors('defaultStatusFilter'),
    disabled: readOnly,
}) }}

<hr>
<h2>{{ 'Control Panel'|t('appleseed') }}</h2>

<p class="light">{{ 'How Appleseed appears in the control panel’s sidebar. An override set in Settings → Control Panel Navigation takes precedence.'|t('appleseed') }}</p>

{{ forms.textField({
    label: 'Sidebar Label'|t('appleseed'),
    instructions: 'Leave empty for “Appleseed”.'|t('appleseed'),
    id: 'navLabel',
    name: 'navLabel',
    value: settings.navLabel,
    placeholder: 'Appleseed',
    maxlength: 64,
    errors: settings.getErrors('navLabel'),
    disabled: readOnly,
}) }}

{{ forms.iconPickerField({
    label: 'Sidebar Icon'|t('appleseed'),
    instructions: 'Leave empty for Appleseed’s own icon.'|t('appleseed'),
    id: 'navIcon',
    name: 'navIcon',
    value: settings.navIcon,
    errors: settings.getErrors('navIcon'),
    disabled: readOnly,
}) }}

{{ forms.textareaField({
    label: 'Custom SVG Icon'|t('appleseed'),
    instructions: 'Optional. Paste one `<svg>` element to use instead of the icon above. It’s sanitised every time it’s drawn; a single-colour icon using `currentColor` matches the rest of the sidebar.'|t('appleseed'),
    id: 'navIconSvg',
    name: 'navIconSvg',
    value: settings.navIconSvg,
    rows: 4,
    class: 'code',
    errors: settings.getErrors('navIconSvg'),
    disabled: readOnly,
}) }}
