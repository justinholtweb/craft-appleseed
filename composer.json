{
    "name": "justinholtweb/craft-appleseed",
    "description": "Broken link checker for Craft CMS. Finds links in your entries and rendered pages, checks them, and reports what's broken.",
    "type": "craft-plugin",
    "version": "6.0.0-beta.1",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "appleseed",
        "broken links",
        "link checker",
        "seo",
        "laravel",
        "mcp",
        "graphql"
    ],
    "license": "proprietary",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "docs": "https://github.com/justinholtweb/craft-appleseed/blob/6.0.0/README.md",
        "source": "https://github.com/justinholtweb/craft-appleseed",
        "issues": "https://github.com/justinholtweb/craft-appleseed/issues"
    },
    "require": {
        "php": "^8.5",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "craftcms/cms": "^6.0.0-beta.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "JustinHoltWeb\\Appleseed\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JustinHoltWeb\\Appleseed\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "check-cs": "pint --test",
        "fix-cs": "pint"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "extra": {
        "name": "Appleseed",
        "handle": "appleseed",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://github.com/justinholtweb/craft-appleseed/blob/6.0.0/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-appleseed/6.0.0/CHANGELOG.md",
        "class": "JustinHoltWeb\\Appleseed\\Plugin"
    }
}
