includes:
    - vendor/craftcms/phpstan/phpstan.neon

parameters:
    level: 5
    paths:
        - src
    # The dev install is Craft 5.10, which has no MCP server. These stand in for the Craft 5.12.1 /
    # mcp/sdk classes src/mcp uses (registered only on 5.12.1+).
    scanFiles:
        - tests/_stubs/mcp.php
